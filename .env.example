# Development-only defaults for the local M0 foundation stack.
# Copy to .env for local use. Never place production credentials in this file.
NODE_ENV=development
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Server-side base URL used by the private enterprise portal. This is not a
# browser-exposed secret; staging/production must point it at the approved API.
PORTAL_API_BASE_URL=http://127.0.0.1:3000
# Public build-time endpoint used by the native user mini-program package.
# Production must inject an approved HTTPS request domain; this local default
# is not production-ready and contains no secret.
USER_MINIAPP_API_BASE_URL=http://127.0.0.1:3000

MYSQL_PORT=3306
MYSQL_DATABASE=fulishe
MYSQL_USER=fulishe
MYSQL_PASSWORD=fulishe_mysql_dev_only
MYSQL_ROOT_PASSWORD=fulishe_mysql_root_dev_only
DATABASE_URL=mysql://fulishe:fulishe_mysql_dev_only@127.0.0.1:3306/fulishe?connect_timeout=3&pool_timeout=5

REDIS_PORT=6379
REDIS_PASSWORD=fulishe_redis_dev_only
REDIS_URL=redis://:fulishe_redis_dev_only@127.0.0.1:6379/0

# Development-only 256-bit-equivalent base64url key. Inject a different secret
# from the deployment secret manager in staging/production; rotating it revokes
# existing supplier portal sessions.
SUPPLIER_AUTH_SESSION_SIGNING_KEY=development-only-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

INFRA_CONNECT_TIMEOUT_MS=3000
INFRA_HEALTH_TIMEOUT_MS=1500
INFRA_MAX_RETRIES=3
INFRA_RETRY_BASE_DELAY_MS=250
INFRA_RETRY_MAX_DELAY_MS=1000
BULLMQ_PREFIX=fulishe
TZ=Asia/Shanghai
