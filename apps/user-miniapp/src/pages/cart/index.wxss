.page { min-height: 100vh; padding: 28rpx 24rpx 180rpx; background: #f7f5f1; color: #2d241f; box-sizing: border-box; }
.header { margin-bottom: 24rpx; }
.title { font-size: 42rpx; font-weight: 700; }
.seller { margin-top: 8rpx; color: #76665d; font-size: 24rpx; }
.state-card, .supplier-card, .message, .order-no { margin-bottom: 20rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }
.supplier-title { padding-bottom: 18rpx; color: #8f3b2c; font-size: 26rpx; font-weight: 600; border-bottom: 1rpx solid #eee4dc; }
.product-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f2ece7; }
.product-row:last-child { border-bottom: 0; }
.product-main { min-width: 0; }
.product-name { font-size: 30rpx; font-weight: 600; }
.product-price { margin-top: 8rpx; color: #8a7a70; font-size: 24rpx; }
.line-amount { font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.message.warning { color: #9c4a19; background: #fff3df; }
.order-no { color: #4c6b3c; }
.checkout-bar { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -6rpx 24rpx rgba(61, 38, 24, .08); }
.checkout-label { color: #76665d; font-size: 22rpx; }
.total { color: #a93627; font-size: 38rpx; font-weight: 700; }
.submit { margin: 0; padding: 0 38rpx; border-radius: 999rpx; background: #d64b35; color: #fff; font-size: 28rpx; line-height: 80rpx; }
.submit[disabled] { background: #c9bcb5; color: #fff; }
