.page { padding: 28rpx; min-height: 100vh; box-sizing: border-box; background: linear-gradient(180deg, #fff1bd 0, #fff8e8 360rpx); }
.hero { padding: 34rpx; border-radius: 28rpx; color: #5d2c00; background: linear-gradient(135deg, #ffcf3f, #ff9f1a); box-shadow: 0 18rpx 50rpx rgba(138, 71, 0, .16); }
.eyebrow { font-size: 24rpx; font-weight: 700; }
.title { margin-top: 12rpx; font-size: 48rpx; font-weight: 900; }
.subtitle { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; }
.state-card { margin-top: 28rpx; padding: 34rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 34rpx rgba(110, 67, 17, .09); }
.state-title { font-size: 32rpx; font-weight: 800; }
.state-message { margin-top: 14rpx; color: #66757b; font-size: 26rpx; line-height: 1.7; }
.primary { display: block; margin-top: 28rpx; padding: 24rpx; border-radius: 18rpx; color: #fff; font-weight: 800; text-align: center; background: #e94b35; }
.safety { margin: 30rpx 12rpx; color: #846c5d; font-size: 23rpx; line-height: 1.7; }
