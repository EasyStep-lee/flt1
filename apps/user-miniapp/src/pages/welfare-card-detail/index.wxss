.page{min-height:100vh;background:#fff8e8;padding:28rpx;color:#2d3235}.hero{background:linear-gradient(135deg,#ffcc33,#ff9f43);border-radius:28rpx;padding:34rpx;box-shadow:0 12rpx 30rpx rgba(154,91,0,.14)}.eyebrow{font-size:22rpx;color:#7a4700}.title{font-size:44rpx;font-weight:800;margin-top:8rpx}.subtitle{font-size:24rpx;margin-top:10rpx;color:#5f4930}.state-card,.balance-card,.ledger-card{margin-top:24rpx;background:#fff;border-radius:24rpx;padding:28rpx;box-shadow:0 8rpx 24rpx rgba(88,65,30,.08)}.state-title,.section-title{font-size:30rpx;font-weight:700}.state-message{margin:14rpx 0;color:#687277}.program{color:#7a5a20}.amount{font-size:54rpx;font-weight:800;margin-top:18rpx}.caption{font-size:22rpx;color:#7b8589}.balance-grid{display:flex;gap:20rpx;margin-top:24rpx}.balance-grid view{flex:1;background:#fff8e8;padding:18rpx;border-radius:16rpx}.balance-grid text,.balance-grid strong{display:block}.balance-grid text{font-size:22rpx;color:#7b8589}.balance-grid strong{margin-top:6rpx}.ledger-row{display:flex;justify-content:space-between;gap:20rpx;padding:24rpx 0;border-bottom:1rpx solid #f0eadb}.ledger-row:last-child{border-bottom:0}.ledger-type{font-weight:700}.ledger-time{font-size:21rpx;color:#899194;margin-top:8rpx}.ledger-amount{font-weight:800}.credit{color:#c73b2f}.debit{color:#3b6f63}.safety{text-align:center;font-size:21rpx;color:#8a7661;margin:30rpx 0}
