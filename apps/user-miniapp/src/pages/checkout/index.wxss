.page { min-height: 100vh; padding: 28rpx; background: #fff8e8; color: #2f2618; box-sizing: border-box; }
.header { padding: 24rpx 8rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle, .scope, .notice { color: #6f6252; font-size: 24rpx; line-height: 1.6; }
.state-card, .summary-card, .account-card, .no-card { margin: 20rpx 0; padding: 28rpx; border: 2rpx solid #ead9b8; border-radius: 24rpx; background: #fff; box-sizing: border-box; }
.summary-card > view, .account-head, .money { display: flex; justify-content: space-between; gap: 20rpx; }
.summary-card .total { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #eee1c9; font-size: 34rpx; font-weight: 700; }
.section-title { margin-top: 32rpx; font-size: 32rpx; font-weight: 700; }
.account-card, .no-card { width: 100%; text-align: left; line-height: 1.5; }
.account-card.selected, .no-card.selected { border-color: #e5672e; box-shadow: 0 0 0 4rpx rgba(229, 103, 46, .12); }
.account-head { font-weight: 700; }
.scope { margin-top: 10rpx; }
.money { margin-top: 18rpx; font-size: 26rpx; }
.deduction { margin-top: 12rpx; color: #b8471b; font-weight: 700; }
.no-card { text-align: center; }
.notice { margin: 24rpx 8rpx; }
.pay-button { margin-top: 28rpx; border-radius: 999rpx; background: #d64b35; color: #fff; font-weight: 700; }
.pay-button[disabled] { background: #c9bcb5; }
.unknown-state { margin-top: 18rpx; color: #9a4d16; line-height: 1.6; }
.paid-state { color: #356b2f; font-weight: 700; }
