{
  "name": "@fulishe/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "config:check": "pnpm --filter @fulishe/config build && node --env-file=.env.example ./scripts/check-config.mjs",
    "infra:config": "docker compose -f compose.yaml config --quiet",
    "infra:down": "docker compose -f compose.yaml down --remove-orphans",
    "infra:status": "docker compose -f compose.yaml ps",
    "infra:up": "docker compose -f compose.yaml up -d --wait",
    "lint": "turbo run lint && eslint scripts/generate-openapi.ts scripts/check-openapi-breaking.mjs scripts/check-openapi-generated.mjs scripts/write-test-report-manifest.mjs tests/openapi tests/test-foundation tests/e2e vitest.config.ts vitest.report.config.ts playwright.config.ts --max-warnings=0",
    "openapi:breaking": "node ./scripts/check-openapi-breaking.mjs",
    "openapi:check": "node ./scripts/check-openapi-generated.mjs",
    "openapi:generate": "tsx --tsconfig ./apps/api/tsconfig.json ./scripts/generate-openapi.ts",
    "prisma:generate": "pnpm --filter @fulishe/db prisma:generate",
    "prisma:validate": "pnpm --filter @fulishe/db prisma:validate",
    "secrets:scan": "pnpm --filter @fulishe/config build && node ./scripts/scan-secrets.mjs --tracked",
    "test": "pnpm test:shells && pnpm test:miniapp-transport && pnpm test:openapi && pnpm test:foundation-contract && turbo run test",
    "test:api": "pnpm build && pnpm --filter @fulishe/api test:api",
    "test:api:supertest": "pnpm --filter @fulishe/api... build && vitest run --config ./vitest.config.ts --project api-contract",
    "test:config": "pnpm --filter @fulishe/config build && pnpm --filter @fulishe/api build && node --test ./tests/configuration/*.test.mjs",
    "test:e2e:foundation": "pnpm --filter @fulishe/portal-web build && playwright test --config ./playwright.config.ts",
    "test:foundation-contract": "node --test ./tests/test-foundation/test-foundation-contract.test.mjs",
    "test:infra": "pnpm build && pnpm --filter @fulishe/api test:infra",
    "test:infra:degraded": "pnpm build && pnpm --filter @fulishe/api test:infra:degraded",
    "test:miniapp-transport": "node --test ./tests/application-shells/miniapp-transport-boundary.test.mjs",
    "test:openapi": "node --test ./tests/openapi/*.test.mjs",
    "test:reports": "pnpm test:reports:vitest && pnpm test:e2e:foundation && node ./scripts/write-test-report-manifest.mjs",
    "test:reports:vitest": "pnpm --filter @fulishe/api... build && vitest run --config ./vitest.report.config.ts",
    "test:seo-cache": "pnpm --filter @fulishe/portal-web build && pnpm --filter @fulishe/portal-web test:boundaries",
    "test:shells": "node --test ./tests/application-shells/app-shells.contract.test.mjs",
    "test:unit": "vitest run --config ./vitest.config.ts --project unit",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.openapi.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "workspace:check": "node ./scripts/verify-workspace-foundation.mjs --root .",
    "workspace:graph": "turbo run build --dry=json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "turbo": "2.10.8",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/swagger@11.4.6>js-yaml": "5.2.2",
      "effect": "3.20.0",
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
