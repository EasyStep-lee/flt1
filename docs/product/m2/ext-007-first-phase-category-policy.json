  "templateBusinessInputs": {
    "publicCommonFields": {
      "required": ["product_name", "category_id", "brand", "main_image", "detail_images", "sku_code", "barcode", "specification", "unit", "weight", "origin"],
      "optional": ["subtitle", "keywords", "selling_points"]
    },
    "foodRequiredFields": [
      "food_name",
      "brand",
      "net_content",
      "ingredients",
      "manufacturer",
      "production_license_number",
      "product_standard_code",
      "origin",
      "shelf_life",
      "storage_conditions",
      "nutrition_facts",
      "label_images"
    ],
    "foodBatchFields": ["production_date", "shelf_life", "expiry_date", "batch_no"],
    "genericRequiredFields": [
      "product_name",
      "brand",
      "category_id",
      "sku_code",
      "barcode",
      "specification",
      "unit",
      "material_or_main_ingredients_when_applicable",
      "origin",
      "manufacturer_or_responsible_entity",
      "images",
      "details",
      "instructions_when_applicable"
    ],
    "categorySpecificExamples": {
      "保温杯": ["capacity", "material", "thermal_performance", "food_contact_grade"],
      "毛巾": ["material", "size", "gram_weight"],
      "洗衣液": ["net_content", "main_ingredients", "instructions", "precautions"]
    }
  },
  "qualificationRules": {
    "company": ["business_license", "unified_social_credit_code", "legal_name", "legal_representative_or_principal", "registered_address", "business_status"],
    "foodCompanyConditional": ["prepackaged_food_filing_or_applicable_food_business_license"],
    "supplier": ["supplier_name", "unified_social_credit_code", "business_license", "contact", "contact_method", "address", "supplied_categories", "cooperation_status"],
    "foodSupplierAdditional": ["food_qualification", "qualification_number", "validity", "purchase_source_evidence"],
    "foodProduct": ["label_images", "production_license_information", "manufacturer_information", "product_standard_information", "supplier_information", "purchase_evidence"],
    "genericProduct": ["package_or_label_images", "manufacturer_information", "product_standard_when_applicable", "supplier_information", "purchase_evidence"],
    "conditionalProduct": ["inspection_report", "certification", "brand_authorization", "distribution_authorization", "other_category_specific_material"]
  },
  "qualificationValidity": {
    "types": ["LONG_TERM", "DATE_RANGE"],
    "dateRangeFields": ["effective_date", "expiry_date"],
    "reminderDays": [30, 7],
    "statuses": ["EXPIRING_SOON", "EXPIRING_URGENT", "EXPIRED"],
    "expiredRequiredQualificationBlocksSale": true,
    "resumeRequiresResubmissionAndApproval": true
  },
  "shelfLifeRules": {
    "statuses": ["NORMAL", "NEAR_EXPIRY", "EXPIRED"],
    "expiredBatchSaleable": false,
    "thresholdsConfigurable": true,
    "runtimeDeliveryStage": "M3_OR_LATER_WHEN_BATCH_INVENTORY_IS_IMPLEMENTED"
  },
  "afterSales": {
    "categoryBound": true,
    "genericDefault": "7_DAY_RETURN_SUPPORTED_WHEN_LEGALLY_ELIGIBLE_AND_INTACT",
    "foodPolicies": ["7_DAY_RETURN_SUPPORTED", "7_DAY_RETURN_CONDITIONAL", "7_DAY_RETURN_NOT_APPLICABLE"],
    "operatorArbitrarySelectionForbidden": true,
    "qualityIssueAlwaysAccepted": true,
    "qualityResolutions": ["REFUND", "RETURN_AND_REFUND", "EXCHANGE", "RESEND"],
    "foodSafetyRiskReviewMayPause": ["SKU", "BATCH", "SUPPLIER_PRODUCT"]
  },
  "saleEligibility": [
    "CATEGORY_ENABLED",
    "SUPPLIER_ACTIVE",
    "SUBJECT_QUALIFICATION_VALID",
    "REQUIRED_FIELDS_COMPLETE",
    "REQUIRED_PRODUCT_QUALIFICATION_VALID",
    "PRODUCT_APPROVED",
    "FOOD_NOT_EXPIRED",
    "NOT_RESTRICTED_OR_UNAPPROVED_HIGH_RISK"
  ],
  "developmentMappings": {
    "price": {
      "sourceTerms": ["sale_price", "market_price"],
      "canonicalRule": "Do not add generic price fields; use existing supply, retail sale and enterprise sale price versions in integer cents."
    },
    "stock": {
      "sourceTerm": "stock",
      "canonicalRule": "Use the existing single InventoryBalance per SKU; do not add template stock fields."
    },
    "supplier": {
      "sourceTerm": "supplier_id",
      "canonicalRule": "Derive supplierId from the verified session; never trust supplier_id from a client."
    },
    "restrictedStatus": {
      "sourceTerms": ["CATEGORY_STATUS=DISABLED", "REGULATED_DISABLED"],
      "canonicalRule": "Persist Category.status=DISABLED and require HIGH_RISK explicit RegulatedCategoryControl approval before enablement; REGULATED_DISABLED is not a new runtime enum."
    },
    "afterSales": {
      "sourceTerm": "AFTER_SALES_POLICY",
      "canonicalRule": "Use the existing immutable CategoryTemplate.afterSaleRules in M2; full after-sales workflow remains M5."
    },
    "shelfLife": {
      "sourceTerm": "SHELF_LIFE_RULE",
      "canonicalRule": "Record the approved configurable rule input now; batch inventory and expiry execution are not retroactively added to completed M2 slices."
    }
  }
}
