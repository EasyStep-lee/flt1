generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum SupplierStatus {
  DRAFT
  PENDING_REVIEW
  CORRECTION_REQUIRED
  ACTIVE
  SUSPENDED
  EXITING
  EXITED
}

enum ApprovalType {
  SUPPLIER_ONBOARDING
  FUNCTIONAL_ACCOUNT_CHANGE
  SENSITIVE_EXPORT
  SUPPLIER_SENSITIVE_CHANGE
}

enum ApprovalObjectType {
  SUPPLIER
  FUNCTIONAL_ACCOUNT
  EXPORT_JOB
}

enum ApprovalApplicantType {
  COMPANY_USER
  SUPPLIER_USER
}

enum ApprovalTaskStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAccountTypeCode {
  COMPANY_SUPPLIER_OPS
  COMPANY_SUPER_ADMIN
  COMPANY_AUDIT
  SUPPLIER_ACCOUNT_ADMIN
}

enum SupplierStatusEvent {
  REGISTER
  SUBMIT
  REQUEST_CORRECTION
  RESUBMIT
  APPROVE
  SUSPEND
  START_EXIT
  COMPLETE_EXIT
}

enum FunctionalOwnerType {
  COMPANY
  SUPPLIER
}

enum FunctionalAccountTypeStatus {
  ACTIVE
  DISABLED
}

enum FunctionalIdentityType {
  COMPANY_USER
  SUPPLIER_USER
}

enum SupplierUserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  REVOKED
}

enum CompanyUserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  REVOKED
}

enum LoginAuditUserType {
  COMPANY_USER
  SUPPLIER_USER
  UNKNOWN
}

enum LoginAuditResult {
  SUCCESS
  AUTH_INVALID
  ACCOUNT_SUSPENDED
  RATE_LIMITED
  SECOND_VERIFICATION_REQUIRED
}

enum FunctionalAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  REVOKED
}

enum FunctionalAccountStatusEvent {
  INVITE
  ACTIVATE
  SUSPEND
  RESTORE
  REVOKE
}

enum AuditActorType {
  COMPANY_USER
  SUPPLIER_USER
  SYSTEM
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  EXPORT
  REVEAL
  MANAGE
  REVOKE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum DataScopeType {
  COMPANY
  SUPPLIER
  SELF
  RESOURCE_SET
}

enum FieldAccessMode {
  HIDDEN
  MASKED
  VISIBLE
  VISIBLE_WITH_AUDIT
  APPROVED_EXPORT_ONLY
}

model Company {
  id                 String        @id @default(uuid()) @db.Char(36)
  legalName          String        @unique @map("legal_name") @db.VarChar(128)
  platformName       String        @unique @map("platform_name") @db.VarChar(64)
  wechatPayConfigRef String        @map("wechat_pay_config_ref") @db.VarChar(255)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  suppliers          Supplier[]
  users              CompanyUser[]
  functionalAccounts FunctionalAccount[]

  @@map("company")
}

model CompanyUser {
  id          String            @id @default(uuid()) @db.Char(36)
  companyId   String            @map("company_id") @db.Char(36)
  name        String            @db.VarChar(128)
  mobile      String            @db.VarChar(16)
  email       String            @db.VarChar(254)
  status      CompanyUserStatus @default(INVITED)
  lastLoginAt DateTime          @default(now()) @map("last_login_at") @db.DateTime(3)
  version     Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selections  CompanyAuthSelection[]

  @@unique([companyId, mobile], map: "company_user_company_mobile_key")
  @@unique([companyId, email], map: "company_user_company_email_key")
  @@index([companyId, status], map: "company_user_company_status_idx")
  @@map("company_user")
}

model Supplier {
  id                      String                  @id @default(uuid()) @db.Char(36)
  companyId               String                  @map("company_id") @db.Char(36)
  legalName               String                  @map("legal_name") @db.VarChar(128)
  creditCode              String                  @unique @map("credit_code") @db.Char(18)
  status                  SupplierStatus          @default(DRAFT)
  pickupAddress           String?                 @map("pickup_address") @db.VarChar(500)
  pickupLat               Decimal?                @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng               Decimal?                @map("pickup_lng") @db.Decimal(10, 7)
  settlementAccountMasked String?                 @map("settlement_account_masked") @db.VarChar(128)
  qualificationSnapshot   Json                    @map("qualification_snapshot")
  version                 Int                     @default(0)
  submittedAt             DateTime?               @map("submitted_at") @db.DateTime(3)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory           SupplierStatusHistory[]
  users                   SupplierUser[]
  functionalAccounts      FunctionalAccount[]

  @@index([companyId, status], map: "supplier_company_id_status_idx")
  @@map("supplier")
}

model FunctionalAccountType {
  id                 String                      @id @default(uuid()) @db.Char(36)
  ownerType          FunctionalOwnerType         @map("owner_type")
  code               String                      @db.VarChar(64)
  name               String                      @db.VarChar(128)
  workspaceRoute     String                      @map("workspace_route") @db.VarChar(255)
  internalMenuSchema Json                        @map("internal_menu_schema")
  status             FunctionalAccountTypeStatus @default(ACTIVE)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)
  accounts           FunctionalAccount[]

  @@unique([ownerType, code], map: "functional_account_type_owner_code_key")
  @@unique([ownerType, workspaceRoute], map: "functional_account_type_owner_route_key")
  @@map("functional_account_type")
}

model SupplierUser {
  id            String             @id @default(uuid()) @db.Char(36)
  supplierId    String             @map("supplier_id") @db.Char(36)
  name          String             @db.VarChar(128)
  mobile        String             @db.VarChar(16)
  email         String?            @db.VarChar(254)
  status        SupplierUserStatus @default(INVITED)
  lastLoginAt   DateTime?          @map("last_login_at") @db.DateTime(3)
  version       Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selections    SupplierAuthSelection[]

  @@unique([supplierId, mobile], map: "supplier_user_supplier_mobile_key")
  @@index([supplierId, status], map: "supplier_user_supplier_status_idx")
  @@map("supplier_user")
}

model FunctionalAccount {
  id             String                  @id @default(uuid()) @db.Char(36)
  identityType   FunctionalIdentityType  @map("identity_type")
  identityId     String                  @map("identity_id") @db.Char(36)
  ownerType      FunctionalOwnerType     @map("owner_type")
  companyId      String?                 @map("company_id") @db.Char(36)
  supplierId     String?                 @map("supplier_id") @db.Char(36)
  accountTypeId  String                  @map("account_type_id") @db.Char(36)
  displayName    String                  @map("display_name") @db.VarChar(128)
  status         FunctionalAccountStatus @default(PENDING_ACTIVATION)
  expiresAt      DateTime?               @map("expires_at") @db.DateTime(3)
  version        Int                     @default(0)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  supplier       Supplier?               @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company        Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountType    FunctionalAccountType   @relation(fields: [accountTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory  FunctionalAccountStatusHistory[]
  permissions    FunctionalAccountPermission[]
  dataScopePolicy DataScopePolicy?
  fieldAccessPolicies FieldAccessPolicy[]
  authSessions    AuthSession[]

  @@unique([supplierId, identityId, accountTypeId], map: "functional_account_supplier_identity_type_key")
  @@unique([companyId, identityId, accountTypeId], map: "functional_account_company_identity_type_key")
  @@index([supplierId, status], map: "functional_account_supplier_status_idx")
  @@index([companyId, status], map: "functional_account_company_status_idx")
  @@index([identityType, identityId], map: "functional_account_identity_idx")
  @@map("functional_account")
}

model AuthSession {
  id                  String                 @id @default(uuid()) @db.Char(36)
  userType            FunctionalIdentityType @map("user_type")
  userId              String                 @map("user_id") @db.Char(36)
  functionalAccountId String                 @map("functional_account_id") @db.Char(36)
  workspaceRoute      String                 @map("workspace_route") @db.VarChar(255)
  sessionHash         String                 @unique(map: "auth_session_hash_key") @map("session_hash") @db.Char(64)
  deviceInfo          Json                   @map("device_info")
  ip                  String                 @db.VarChar(45)
  expiresAt           DateTime               @map("expires_at") @db.DateTime(3)
  revokedAt           DateTime?              @map("revoked_at") @db.DateTime(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  functionalAccount   FunctionalAccount      @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userType, userId, revokedAt, expiresAt], map: "auth_session_user_active_idx")
  @@index([functionalAccountId, revokedAt], map: "auth_session_account_active_idx")
  @@map("auth_session")
}

model CompanyAuthSelection {
  id                         String      @id @default(uuid()) @db.Char(36)
  userId                     String      @map("user_id") @db.Char(36)
  nonceHash                  String      @unique(map: "company_auth_selection_nonce_key") @map("nonce_hash") @db.Char(64)
  requestId                  String      @map("request_id") @db.Char(36)
  secondVerificationRequired Boolean     @default(false) @map("second_verification_required")
  selectedAccountId          String?     @map("selected_account_id") @db.Char(36)
  selectedSessionId          String?     @map("selected_session_id") @db.Char(36)
  expiresAt                  DateTime    @map("expires_at") @db.DateTime(3)
  usedAt                     DateTime?   @map("used_at") @db.DateTime(3)
  createdAt                  DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  user                       CompanyUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt], map: "company_auth_selection_user_expiry_idx")
  @@unique([userId, requestId], map: "company_auth_selection_user_request_key")
  @@map("company_auth_selection")
}

model SupplierAuthSelection {
  id                         String       @id @default(uuid()) @db.Char(36)
  userId                     String       @map("user_id") @db.Char(36)
  nonceHash                  String       @unique(map: "supplier_auth_selection_nonce_key") @map("nonce_hash") @db.Char(64)
  requestId                  String       @map("request_id") @db.Char(36)
  secondVerificationRequired Boolean      @default(false) @map("second_verification_required")
  secondVerificationClaimId String?       @map("second_verification_claim_id") @db.Char(36)
  secondVerificationClaimedAt DateTime?   @map("second_verification_claimed_at") @db.DateTime(3)
  secondVerifiedAt          DateTime?     @map("second_verified_at") @db.DateTime(3)
  selectedAccountId          String?      @map("selected_account_id") @db.Char(36)
  selectedSessionId          String?      @map("selected_session_id") @db.Char(36)
  expiresAt                  DateTime     @map("expires_at") @db.DateTime(3)
  usedAt                     DateTime?    @map("used_at") @db.DateTime(3)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  user                       SupplierUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt], map: "supplier_auth_selection_user_expiry_idx")
  @@unique([userId, requestId], map: "supplier_auth_selection_user_request_key")
  @@map("supplier_auth_selection")
}

model LoginAudit {
  id                  String             @id @default(uuid()) @db.Char(36)
  userType            LoginAuditUserType @map("user_type")
  userId              String?            @map("user_id") @db.Char(36)
  functionalAccountId String?            @map("functional_account_id") @db.Char(36)
  loginAccountHash    String             @map("login_account_hash") @db.Char(64)
  result              LoginAuditResult
  riskReason          String             @map("risk_reason") @db.VarChar(128)
  deviceInfo          Json               @map("device_info")
  ip                  String             @db.VarChar(45)
  occurredAt          DateTime           @default(now()) @map("occurred_at") @db.DateTime(3)

  @@index([loginAccountHash, occurredAt], map: "login_audit_account_time_idx")
  @@index([userType, userId, occurredAt], map: "login_audit_user_time_idx")
  @@map("login_audit")
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  code        String           @unique @db.VarChar(64)
  resource    String           @db.VarChar(128)
  action      PermissionAction
  fieldGroup  String?          @map("field_group") @db.VarChar(128)
  riskLevel   Int              @map("risk_level")
  accounts    FunctionalAccountPermission[]

  @@map("permission")
}

model FunctionalAccountPermission {
  id                    String             @id @default(uuid()) @db.Char(36)
  functionalAccountId   String             @map("functional_account_id") @db.Char(36)
  permissionId          String             @map("permission_id") @db.Char(36)
  effect                PermissionEffect
  functionalAccount     FunctionalAccount  @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "functional_account_permission_account_id_fkey")
  permission            Permission         @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "functional_account_permission_permission_id_fkey")

  @@unique([functionalAccountId, permissionId], map: "functional_account_permission_account_permission_key")
  @@map("functional_account_permission")
}

model DataScopePolicy {
  id                    String             @id @default(uuid()) @db.Char(36)
  functionalAccountId   String             @unique(map: "data_scope_policy_account_key") @map("functional_account_id") @db.Char(36)
  scopeType             DataScopeType      @map("scope_type")
  scopeRules            Json               @map("scope_rules")
  functionalAccount     FunctionalAccount  @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "data_scope_policy_account_id_fkey")

  @@map("data_scope_policy")
}

model FieldAccessPolicy {
  id                    String             @id @default(uuid()) @db.Char(36)
  functionalAccountId   String             @map("functional_account_id") @db.Char(36)
  resource              String             @db.VarChar(128)
  fieldGroup            String             @map("field_group") @db.VarChar(128)
  accessMode            FieldAccessMode    @default(HIDDEN) @map("access_mode")
  functionalAccount     FunctionalAccount  @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "field_access_policy_account_id_fkey")

  @@unique([functionalAccountId, resource, fieldGroup], map: "field_access_policy_account_resource_group_key")
  @@map("field_access_policy")
}

model FunctionalAccountStatusHistory {
  id              String                       @id @default(uuid()) @db.Char(36)
  functionalAccountId String                   @map("functional_account_id") @db.Char(36)
  fromStatus      FunctionalAccountStatus?     @map("from_status")
  toStatus        FunctionalAccountStatus      @map("to_status")
  event           FunctionalAccountStatusEvent
  actorIdentityId String                       @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime                     @default(now()) @map("occurred_at") @db.DateTime(3)
  functionalAccount FunctionalAccount          @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "functional_account_history_account_id_fkey")

  @@unique([functionalAccountId, version], map: "functional_account_history_account_version_key")
  @@index([functionalAccountId, occurredAt], map: "functional_account_history_account_time_idx")
  @@map("functional_account_status_history")
}

model FunctionalAccountCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(128)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "functional_account_command_scope_key")
  @@map("functional_account_command")
}

model ApprovalTask {
  id                      String                  @id @default(uuid()) @db.Char(36)
  approvalType            ApprovalType            @map("approval_type")
  objectType              ApprovalObjectType      @map("object_type")
  objectId                String                  @map("object_id") @db.Char(36)
  applicantType           ApprovalApplicantType   @map("applicant_type")
  applicantId             String                  @map("applicant_id") @db.Char(36)
  status                  ApprovalTaskStatus      @default(PENDING)
  assignedAccountTypeCode ApprovalAccountTypeCode @map("assigned_account_type_code")
  reviewedBy              String?                 @map("reviewed_by") @db.Char(36)
  reviewOpinion           String?                 @map("review_opinion") @db.VarChar(1000)
  version                 Int                     @default(0)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([objectType, objectId, status], map: "approval_task_object_status_idx")
  @@index([assignedAccountTypeCode, status], map: "approval_task_assignee_status_idx")
  @@map("approval_task")
}

model SupplierStatusHistory {
  id              String              @id @default(uuid()) @db.Char(36)
  supplierId      String              @map("supplier_id") @db.Char(36)
  fromStatus      SupplierStatus?     @map("from_status")
  toStatus        SupplierStatus      @map("to_status")
  event           SupplierStatusEvent
  actorIdentityId String?             @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.DateTime(3)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, version], map: "supplier_status_history_supplier_version_key")
  @@index([supplierId, occurredAt], map: "supplier_status_history_supplier_time_idx")
  @@map("supplier_status_history")
}

model SupplierOnboardingCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(128)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "supplier_onboarding_command_scope_key")
  @@map("supplier_onboarding_command")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Char(36)
  actorType      AuditActorType @map("actor_type")
  actorId        String         @map("actor_id") @db.VarChar(128)
  action         String         @db.VarChar(128)
  objectType     String         @map("object_type") @db.VarChar(128)
  objectId       String         @map("object_id") @db.VarChar(64)
  beforeSnapshot Json           @map("before_snapshot")
  afterSnapshot  Json           @map("after_snapshot")
  requestId      String         @map("request_id") @db.Char(36)
  ip             String?        @db.VarChar(64)
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.DateTime(3)

  @@index([action, occurredAt], map: "audit_log_action_time_idx")
  @@index([objectType, objectId, occurredAt], map: "audit_log_object_time_idx")
  @@index([actorType, actorId, occurredAt], map: "audit_log_actor_time_idx")
  @@index([requestId], map: "audit_log_request_id_idx")
  @@map("audit_log")
}
