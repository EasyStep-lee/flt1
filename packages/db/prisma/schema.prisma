  beforeSnapshot      Json           @map("before_snapshot")
  afterSnapshot       Json           @map("after_snapshot")
  requestId           String         @map("request_id") @db.Char(36)
  ip                  String?        @db.VarChar(64)
  occurredAt          DateTime       @default(now()) @map("occurred_at") @db.DateTime(3)

  @@index([action, occurredAt], map: "audit_log_action_time_idx")
  @@index([objectType, objectId, occurredAt], map: "audit_log_object_time_idx")
  @@index([actorType, actorId, occurredAt], map: "audit_log_actor_time_idx")
  @@index([requestId], map: "audit_log_request_id_idx")
  @@index([supplierId, occurredAt], map: "audit_log_supplier_time_idx")
  @@index([functionalAccountId, occurredAt], map: "audit_log_functional_account_time_idx")
  @@map("audit_log")
}
