model Company {
  id                        String                     @id @default(uuid()) @db.Char(36)
  legalName                 String                     @unique @map("legal_name") @db.VarChar(128)
  platformName              String                     @unique @map("platform_name") @db.VarChar(64)
  wechatPayConfigRef        String                     @map("wechat_pay_config_ref") @db.VarChar(255)
  status                    CompanyStatus              @default(ACTIVE)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  suppliers                 Supplier[]
  users                     CompanyUser[]
  functionalAccounts        FunctionalAccount[]
  products                  Product[]
  categories                Category[]
  categoryTemplates         CategoryTemplate[]
  regulatedCategoryControls RegulatedCategoryControl[]
  supplyPriceChangeRequests SupplyPriceChangeRequest[]
  priceChangeLogs           PriceChangeLog[]
  priceEffectOutboxes       PriceEffectOutbox[]
  buyerOrders               BuyerOrder[]
  refundAuthorizations      RefundAuthorization[]
  enterpriseCustomers       EnterpriseCustomer[]
  welfareCardPrograms       WelfareCardProgram[]
  welfareCardBatches        WelfareCardBatch[]
  welfareCardCommands       WelfareCardCommand[]
  welfareCardBindingCommands WelfareCardBindingCommand[]

  @@map("company")
}

model CompanyUser {
  id          String                 @id @default(uuid()) @db.Char(36)
  companyId   String                 @map("company_id") @db.Char(36)
  name        String                 @db.VarChar(128)
  mobile      String                 @db.VarChar(16)
  email       String                 @db.VarChar(254)
  status      CompanyUserStatus      @default(INVITED)
  lastLoginAt DateTime               @default(now()) @map("last_login_at") @db.DateTime(3)
  version     Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selections  CompanyAuthSelection[]

  @@unique([companyId, mobile], map: "company_user_company_mobile_key")
  @@unique([companyId, email], map: "company_user_company_email_key")
  @@index([companyId, status], map: "company_user_company_status_idx")
  @@map("company_user")
}

model Supplier {
  id                        String                     @id @default(uuid()) @db.Char(36)
  companyId                 String                     @map("company_id") @db.Char(36)
  legalName                 String                     @map("legal_name") @db.VarChar(128)
  creditCode                String                     @unique @map("credit_code") @db.Char(18)
  status                    SupplierStatus             @default(DRAFT)
  pickupAddress             String?                    @map("pickup_address") @db.VarChar(500)
  pickupLat                 Decimal?                   @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng                 Decimal?                   @map("pickup_lng") @db.Decimal(10, 7)
  settlementAccountMasked   String?                    @map("settlement_account_masked") @db.VarChar(128)
  qualificationSnapshot     Json                       @map("qualification_snapshot")
  version                   Int                        @default(0)
  submittedAt               DateTime?                  @map("submitted_at") @db.DateTime(3)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory             SupplierStatusHistory[]
  users                     SupplierUser[]
  functionalAccounts        FunctionalAccount[]
  supplierProducts          SupplierProduct[]
  products                  Product[]
  supplyPriceChangeRequests SupplyPriceChangeRequest[]
  priceChangeLogs           PriceChangeLog[]
  priceEffectOutboxes       PriceEffectOutbox[]
  inventoryChangeLogs       InventoryChangeLog[]
  buyerOrderItems           BuyerOrderItem[]
  fulfillmentOrders         SupplierFulfillmentOrder[]

  @@index([companyId, status], map: "supplier_company_id_status_idx")
  @@map("supplier")
}

model FunctionalAccountType {
  id                 String                      @id @default(uuid()) @db.Char(36)
  ownerType          FunctionalOwnerType         @map("owner_type")
  code               String                      @db.VarChar(64)
  name               String                      @db.VarChar(128)
  workspaceRoute     String                      @map("workspace_route") @db.VarChar(255)
  internalMenuSchema Json                        @map("internal_menu_schema")
  status             FunctionalAccountTypeStatus @default(ACTIVE)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)
  accounts           FunctionalAccount[]

  @@unique([ownerType, code], map: "functional_account_type_owner_code_key")
  @@unique([ownerType, workspaceRoute], map: "functional_account_type_owner_route_key")
  @@map("functional_account_type")
}

model SupplierUser {
  id          String                  @id @default(uuid()) @db.Char(36)
  supplierId  String                  @map("supplier_id") @db.Char(36)
  name        String                  @db.VarChar(128)
  mobile      String                  @db.VarChar(16)
  email       String?                 @db.VarChar(254)
  status      SupplierUserStatus      @default(INVITED)
  lastLoginAt DateTime?               @map("last_login_at") @db.DateTime(3)
  version     Int                     @default(0)
  createdAt   DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  supplier    Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selections  SupplierAuthSelection[]

  @@unique([supplierId, mobile], map: "supplier_user_supplier_mobile_key")
  @@index([supplierId, status], map: "supplier_user_supplier_status_idx")
  @@map("supplier_user")
}

model EnterpriseCustomer {
  id                     String                       @id @default(uuid()) @db.Char(36)
  companyId              String                       @map("company_id") @db.Char(36)
  legalName              String                       @map("legal_name") @db.VarChar(191)
  creditCode             String                       @unique @map("credit_code") @db.Char(18)
  registeredAddress      String?                      @map("registered_address") @db.VarChar(500)
  enterpriseType         String?                      @map("enterprise_type") @db.VarChar(64)
  licenseObjectKey       String?                      @map("license_object_key") @db.VarChar(255)
  licenseValidUntil      DateTime?                    @map("license_valid_until") @db.DateTime(3)
  contactName            String                       @map("contact_name") @db.VarChar(128)
  contactMobile          String                       @map("contact_mobile") @db.VarChar(16)
  contactEmail           String?                      @map("contact_email") @db.VarChar(254)
  contactTitle           String?                      @map("contact_title") @db.VarChar(128)
  agreementVersion       String                       @map("agreement_version") @db.VarChar(64)
  agreementStatus        EnterpriseAgreementStatus    @default(NOT_SIGNED) @map("agreement_status")
  status                 EnterpriseCustomerStatus     @default(DRAFT)
  correctionFields       Json                         @map("correction_fields")
  reviewOpinion          String?                      @map("review_opinion") @db.VarChar(1000)
  version                Int                          @default(0)
  submittedAt            DateTime?                    @map("submitted_at") @db.DateTime(3)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  company                Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users                  EnterpriseUser[]
  addresses              EnterpriseAddress[]
  invoiceProfiles        EnterpriseInvoiceProfile[]
  statusHistory          EnterpriseCustomerStatusHistory[]
  certificationSnapshots EnterpriseCertificationSnapshot[]
  procurementProfile     EnterpriseProcurementProfile?
  procurementOrders      EnterpriseProcurementOrder[]
  welfareCardBatches     WelfareCardBatch[]

  @@index([companyId, status, createdAt], map: "enterprise_customer_company_status_time_idx")
  @@index([contactMobile, status], map: "enterprise_customer_mobile_status_idx")
  @@map("enterprise_customer")
}

model EnterpriseUser {
  id                   String               @id @default(uuid()) @db.Char(36)
  enterpriseCustomerId String               @map("enterprise_customer_id") @db.Char(36)
  identityId           String               @map("identity_id") @db.Char(36)
  role                 EnterpriseUserRole   @default(ENTERPRISE_ADMIN)
  name                 String               @db.VarChar(128)
  mobile               String               @db.VarChar(16)
  email                String?              @db.VarChar(254)
  title                String?              @db.VarChar(128)
  status               EnterpriseUserStatus @default(INVITED)
  createdAt            DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  enterpriseCustomer   EnterpriseCustomer   @relation(fields: [enterpriseCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  procurementOrders    EnterpriseProcurementOrder[]

  @@unique([enterpriseCustomerId, mobile], map: "enterprise_user_enterprise_mobile_key")
  @@unique([enterpriseCustomerId, identityId], map: "enterprise_user_enterprise_identity_key")
  @@index([identityId, status], map: "enterprise_user_identity_status_idx")
  @@map("enterprise_user")
}

model EnterpriseAddress {
  id                   String             @id @default(uuid()) @db.Char(36)
  enterpriseCustomerId String             @map("enterprise_customer_id") @db.Char(36)
  consignee            String             @db.VarChar(128)
  mobile               String             @db.VarChar(16)
  region               String             @db.VarChar(64)
  fullAddress          String             @map("full_address") @db.VarChar(500)
  deliveryNote         String?            @map("delivery_note") @db.VarChar(500)
  lat                  Decimal?           @db.Decimal(10, 7)
  lng                  Decimal?           @db.Decimal(10, 7)
  isDefault            Boolean            @default(false) @map("is_default")
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  enterpriseCustomer   EnterpriseCustomer @relation(fields: [enterpriseCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enterpriseCustomerId, isDefault], map: "enterprise_address_enterprise_default_idx")
  @@map("enterprise_address")
}

model EnterpriseInvoiceProfile {
  id                   String             @id @default(uuid()) @db.Char(36)
  enterpriseCustomerId String             @map("enterprise_customer_id") @db.Char(36)
  title                String             @db.VarChar(191)
  taxNumber            String             @map("tax_number") @db.VarChar(32)
  registeredAddress    String?            @map("registered_address") @db.VarChar(500)
  registeredPhone      String?            @map("registered_phone") @db.VarChar(32)
  bankName             String?            @map("bank_name") @db.VarChar(191)
  bankAccountMasked    String?            @map("bank_account_masked") @db.VarChar(64)
  isDefault            Boolean            @default(true) @map("is_default")
  version              Int                @default(0)
  createdAt            DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  enterpriseCustomer   EnterpriseCustomer @relation(fields: [enterpriseCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "enterprise_invoice_enterprise_customer_id_fkey")

  @@index([enterpriseCustomerId, isDefault], map: "enterprise_invoice_enterprise_default_idx")
  @@map("enterprise_invoice_profile")
}

model EnterpriseCustomerStatusHistory {
  id              String                        @id @default(uuid()) @db.Char(36)
  enterpriseId    String                        @map("enterprise_id") @db.Char(36)
  fromStatus      EnterpriseCustomerStatus?     @map("from_status")
  toStatus        EnterpriseCustomerStatus      @map("to_status")
  event           EnterpriseCustomerStatusEvent
  actorIdentityId String                        @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime                      @default(now()) @map("occurred_at") @db.DateTime(3)
  enterprise      EnterpriseCustomer            @relation(fields: [enterpriseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "enterprise_status_history_enterprise_id_fkey")

  @@unique([enterpriseId, version], map: "enterprise_status_history_enterprise_version_key")
  @@index([enterpriseId, occurredAt], map: "enterprise_status_history_enterprise_time_idx")
  @@map("enterprise_customer_status_history")
}

model EnterpriseCertificationSnapshot {
  id              String             @id @default(uuid()) @db.Char(36)
  enterpriseId    String             @map("enterprise_id") @db.Char(36)
  event           String             @db.VarChar(64)
  actorIdentityId String             @map("actor_identity_id") @db.Char(36)
  payload         Json
  version         Int
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  enterprise      EnterpriseCustomer @relation(fields: [enterpriseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "enterprise_cert_snapshot_enterprise_id_fkey")

  @@unique([enterpriseId, version], map: "enterprise_cert_snapshot_enterprise_version_key")
  @@index([enterpriseId, createdAt], map: "enterprise_cert_snapshot_enterprise_time_idx")
  @@map("enterprise_certification_snapshot")
}

model EnterpriseProcurementProfile {
  id                      String                             @id @default(uuid()) @db.Char(36)
  enterpriseCustomerId    String                             @unique @map("enterprise_customer_id") @db.Char(36)
  defaultInvoiceProfileId String?                            @map("default_invoice_profile_id") @db.Char(36)
  defaultAddressId        String?                            @map("default_address_id") @db.Char(36)
  status                  EnterpriseProcurementProfileStatus @default(DRAFT)
  version                 Int                                @default(0)
  createdAt               DateTime                           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                           @updatedAt @map("updated_at") @db.DateTime(3)
  enterpriseCustomer      EnterpriseCustomer                 @relation(fields: [enterpriseCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("enterprise_procurement_profile")
}

model EnterpriseOnboardingCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(191)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "enterprise_onboarding_command_scope_key")
  @@map("enterprise_onboarding_command")
}

model FunctionalAccount {
  id                  String                           @id @default(uuid()) @db.Char(36)
  identityType        FunctionalIdentityType           @map("identity_type")
  identityId          String                           @map("identity_id") @db.Char(36)
  ownerType           FunctionalOwnerType              @map("owner_type")
  companyId           String?                          @map("company_id") @db.Char(36)
  supplierId          String?                          @map("supplier_id") @db.Char(36)
  accountTypeId       String                           @map("account_type_id") @db.Char(36)
  displayName         String                           @map("display_name") @db.VarChar(128)
  status              FunctionalAccountStatus          @default(PENDING_ACTIVATION)
  expiresAt           DateTime?                        @map("expires_at") @db.DateTime(3)
  version             Int                              @default(0)
  createdAt           DateTime                         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.DateTime(3)
  supplier            Supplier?                        @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company             Company?                         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
