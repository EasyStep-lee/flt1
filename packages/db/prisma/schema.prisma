generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum SupplierStatus {
  DRAFT
  PENDING_REVIEW
  CORRECTION_REQUIRED
  ACTIVE
  SUSPENDED
  EXITING
  EXITED
}

enum ApprovalType {
  SUPPLIER_ONBOARDING
  FUNCTIONAL_ACCOUNT_CHANGE
  SENSITIVE_EXPORT
  SUPPLIER_SENSITIVE_CHANGE
}

enum ApprovalObjectType {
  SUPPLIER
  FUNCTIONAL_ACCOUNT
  EXPORT_JOB
}

enum ApprovalApplicantType {
  COMPANY_USER
  SUPPLIER_USER
}

enum ApprovalTaskStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAccountTypeCode {
  COMPANY_SUPPLIER_OPS
  COMPANY_SUPER_ADMIN
  COMPANY_AUDIT
  SUPPLIER_ACCOUNT_ADMIN
}

enum SupplierStatusEvent {
  REGISTER
  SUBMIT
  REQUEST_CORRECTION
  RESUBMIT
  APPROVE
  SUSPEND
  START_EXIT
  COMPLETE_EXIT
}

enum FunctionalOwnerType {
  COMPANY
  SUPPLIER
}

enum FunctionalAccountTypeStatus {
  ACTIVE
  DISABLED
}

enum FunctionalIdentityType {
  COMPANY_USER
  SUPPLIER_USER
}

enum SupplierUserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  REVOKED
}

enum FunctionalAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  REVOKED
}

enum FunctionalAccountStatusEvent {
  INVITE
  ACTIVATE
  SUSPEND
  RESTORE
  REVOKE
}

enum AuditActorType {
  COMPANY_USER
  SUPPLIER_USER
  SYSTEM
}

model Company {
  id                 String        @id @default(uuid()) @db.Char(36)
  legalName          String        @unique @map("legal_name") @db.VarChar(128)
  platformName       String        @unique @map("platform_name") @db.VarChar(64)
  wechatPayConfigRef String        @map("wechat_pay_config_ref") @db.VarChar(255)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  suppliers          Supplier[]

  @@map("company")
}

model Supplier {
  id                      String                  @id @default(uuid()) @db.Char(36)
  companyId               String                  @map("company_id") @db.Char(36)
  legalName               String                  @map("legal_name") @db.VarChar(128)
  creditCode              String                  @unique @map("credit_code") @db.Char(18)
  status                  SupplierStatus          @default(DRAFT)
  pickupAddress           String?                 @map("pickup_address") @db.VarChar(500)
  pickupLat               Decimal?                @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng               Decimal?                @map("pickup_lng") @db.Decimal(10, 7)
  settlementAccountMasked String?                 @map("settlement_account_masked") @db.VarChar(128)
  qualificationSnapshot   Json                    @map("qualification_snapshot")
  version                 Int                     @default(0)
  submittedAt             DateTime?               @map("submitted_at") @db.DateTime(3)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory           SupplierStatusHistory[]
  users                   SupplierUser[]
  functionalAccounts      FunctionalAccount[]

  @@index([companyId, status], map: "supplier_company_id_status_idx")
  @@map("supplier")
}

model FunctionalAccountType {
  id                 String                      @id @default(uuid()) @db.Char(36)
  ownerType          FunctionalOwnerType         @map("owner_type")
  code               String                      @db.VarChar(64)
  name               String                      @db.VarChar(128)
  workspaceRoute     String                      @map("workspace_route") @db.VarChar(255)
  internalMenuSchema Json                        @map("internal_menu_schema")
  status             FunctionalAccountTypeStatus @default(ACTIVE)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)
  accounts           FunctionalAccount[]

  @@unique([ownerType, code], map: "functional_account_type_owner_code_key")
  @@unique([ownerType, workspaceRoute], map: "functional_account_type_owner_route_key")
  @@map("functional_account_type")
}

model SupplierUser {
  id            String             @id @default(uuid()) @db.Char(36)
  supplierId    String             @map("supplier_id") @db.Char(36)
  name          String             @db.VarChar(128)
  mobile        String             @db.VarChar(16)
  email         String?            @db.VarChar(254)
  status        SupplierUserStatus @default(INVITED)
  lastLoginAt   DateTime?          @map("last_login_at") @db.DateTime(3)
  version       Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accounts      FunctionalAccount[]

  @@unique([supplierId, mobile], map: "supplier_user_supplier_mobile_key")
  @@index([supplierId, status], map: "supplier_user_supplier_status_idx")
  @@map("supplier_user")
}

model FunctionalAccount {
  id             String                  @id @default(uuid()) @db.Char(36)
  identityType   FunctionalIdentityType  @map("identity_type")
  identityId     String                  @map("identity_id") @db.Char(36)
  ownerType      FunctionalOwnerType     @map("owner_type")
  companyId      String?                 @map("company_id") @db.Char(36)
  supplierId     String?                 @map("supplier_id") @db.Char(36)
  accountTypeId  String                  @map("account_type_id") @db.Char(36)
  displayName    String                  @map("display_name") @db.VarChar(128)
  status         FunctionalAccountStatus @default(PENDING_ACTIVATION)
  expiresAt      DateTime?               @map("expires_at") @db.DateTime(3)
  version        Int                     @default(0)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  supplier       Supplier?               @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplierUser   SupplierUser            @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accountType    FunctionalAccountType   @relation(fields: [accountTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory  FunctionalAccountStatusHistory[]

  @@unique([supplierId, identityId, accountTypeId], map: "functional_account_supplier_identity_type_key")
  @@index([supplierId, status], map: "functional_account_supplier_status_idx")
  @@index([identityType, identityId], map: "functional_account_identity_idx")
  @@map("functional_account")
}

model FunctionalAccountStatusHistory {
  id              String                       @id @default(uuid()) @db.Char(36)
  functionalAccountId String                   @map("functional_account_id") @db.Char(36)
  fromStatus      FunctionalAccountStatus?     @map("from_status")
  toStatus        FunctionalAccountStatus      @map("to_status")
  event           FunctionalAccountStatusEvent
  actorIdentityId String                       @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime                     @default(now()) @map("occurred_at") @db.DateTime(3)
  functionalAccount FunctionalAccount          @relation(fields: [functionalAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "functional_account_history_account_id_fkey")

  @@unique([functionalAccountId, version], map: "functional_account_history_account_version_key")
  @@index([functionalAccountId, occurredAt], map: "functional_account_history_account_time_idx")
  @@map("functional_account_status_history")
}

model FunctionalAccountCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(128)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "functional_account_command_scope_key")
  @@map("functional_account_command")
}

model ApprovalTask {
  id                      String                  @id @default(uuid()) @db.Char(36)
  approvalType            ApprovalType            @map("approval_type")
  objectType              ApprovalObjectType      @map("object_type")
  objectId                String                  @map("object_id") @db.Char(36)
  applicantType           ApprovalApplicantType   @map("applicant_type")
  applicantId             String                  @map("applicant_id") @db.Char(36)
  status                  ApprovalTaskStatus      @default(PENDING)
  assignedAccountTypeCode ApprovalAccountTypeCode @map("assigned_account_type_code")
  reviewedBy              String?                 @map("reviewed_by") @db.Char(36)
  reviewOpinion           String?                 @map("review_opinion") @db.VarChar(1000)
  version                 Int                     @default(0)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([objectType, objectId, status], map: "approval_task_object_status_idx")
  @@index([assignedAccountTypeCode, status], map: "approval_task_assignee_status_idx")
  @@map("approval_task")
}

model SupplierStatusHistory {
  id              String              @id @default(uuid()) @db.Char(36)
  supplierId      String              @map("supplier_id") @db.Char(36)
  fromStatus      SupplierStatus?     @map("from_status")
  toStatus        SupplierStatus      @map("to_status")
  event           SupplierStatusEvent
  actorIdentityId String?             @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.DateTime(3)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, version], map: "supplier_status_history_supplier_version_key")
  @@index([supplierId, occurredAt], map: "supplier_status_history_supplier_time_idx")
  @@map("supplier_status_history")
}

model SupplierOnboardingCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(128)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "supplier_onboarding_command_scope_key")
  @@map("supplier_onboarding_command")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Char(36)
  actorType      AuditActorType @map("actor_type")
  actorId        String         @map("actor_id") @db.VarChar(128)
  action         String         @db.VarChar(128)
  objectType     String         @map("object_type") @db.VarChar(128)
  objectId       String         @map("object_id") @db.VarChar(64)
  beforeSnapshot Json           @map("before_snapshot")
  afterSnapshot  Json           @map("after_snapshot")
  requestId      String         @map("request_id") @db.Char(36)
  ip             String?        @db.VarChar(64)
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.DateTime(3)

  @@index([action, occurredAt], map: "audit_log_action_time_idx")
  @@index([objectType, objectId, occurredAt], map: "audit_log_object_time_idx")
  @@index([actorType, actorId, occurredAt], map: "audit_log_actor_time_idx")
  @@index([requestId], map: "audit_log_request_id_idx")
  @@map("audit_log")
}
