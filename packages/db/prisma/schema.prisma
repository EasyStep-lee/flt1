  requestId             String   @map("request_id") @db.VarChar(64)
  ip                    String?  @db.VarChar(64)
  occurredAt            DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  batch                 WelfareCardBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchId, occurredAt], map: "welfare_card_batch_history_batch_time_idx")
  @@map("welfare_card_batch_history")
}

model WelfareCardCommand {
  id                    String   @id @default(uuid()) @db.Char(36)
  companyId             String   @map("company_id") @db.Char(36)
  operation             String   @db.VarChar(32)
  idempotencyKey        String   @map("idempotency_key") @db.VarChar(128)
  requestHash           String   @map("request_hash") @db.Char(64)
  responseSnapshot      Json     @map("response_snapshot")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  company               Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, idempotencyKey], map: "welfare_card_command_company_key")
  @@map("welfare_card_command")
}

model WelfareCardCode {
  id                      String    @id @default(uuid()) @db.Char(36)
  batchId                 String    @map("batch_id") @db.Char(36)
  cardNo                  String    @unique(map: "welfare_card_code_card_no_key") @map("card_no") @db.VarChar(191)
  secretHash              String    @map("secret_hash") @db.VarChar(191)
  amount                  Int
  status                  String    @default("UNCLAIMED") @db.VarChar(16)
  claimedByConsumerUserId String?   @map("claimed_by_consumer_user_id") @db.Char(36)
  claimedAt               DateTime? @map("claimed_at") @db.DateTime(3)
  version                 Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  batch                   WelfareCardBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account                 WelfareCardAccount?

  @@index([batchId, status, createdAt], map: "welfare_card_code_batch_status_time_idx")
  @@map("welfare_card_code")
}

model WelfareCardAccount {
  id             String   @id @default(uuid()) @db.Char(36)
  consumerUserId String   @map("consumer_user_id") @db.Char(36)
  programId      String   @map("program_id") @db.Char(36)
  batchId        String   @map("batch_id") @db.Char(36)
  cardCodeId     String   @unique(map: "welfare_card_account_card_code_id_key") @map("card_code_id") @db.Char(36)
  balanceAmount  Int      @map("balance_amount")
  frozenAmount   Int      @default(0) @map("frozen_amount")
  status         String   @default("ACTIVE") @db.VarChar(16)
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  program        WelfareCardProgram @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch          WelfareCardBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cardCode       WelfareCardCode @relation(fields: [cardCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledger         WelfareCardLedger[]

  @@index([consumerUserId, status, createdAt], map: "welfare_card_account_consumer_status_time_idx")
  @@index([programId, status], map: "welfare_card_account_program_status_idx")
  @@index([batchId, status], map: "welfare_card_account_batch_status_idx")
  @@map("welfare_card_account")
}

model WelfareCardLedger {
  id             String   @id @default(uuid()) @db.Char(36)
  accountId      String   @map("account_id") @db.Char(36)
  orderId        String?  @map("order_id") @db.Char(36)
  refundId       String?  @map("refund_id") @db.Char(36)
  businessType   String   @map("business_type") @db.VarChar(32)
  direction      String   @db.VarChar(16)
  amount         Int
  beforeBalance  Int      @map("before_balance")
  afterBalance   Int      @map("after_balance")
  beforeFrozen   Int      @map("before_frozen")
  afterFrozen    Int      @map("after_frozen")
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  account        WelfareCardAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([accountId, idempotencyKey], map: "welfare_card_ledger_account_key")
  @@index([accountId, occurredAt], map: "welfare_card_ledger_account_time_idx")
  @@map("welfare_card_ledger")
}

model WelfareCardBindingCommand {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @map("company_id") @db.Char(36)
  consumerUserId String   @map("consumer_user_id") @db.Char(36)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
