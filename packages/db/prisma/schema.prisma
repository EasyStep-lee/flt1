  functionalAccountId   String   @map("functional_account_id") @db.Char(36)
  requestId             String   @map("request_id") @db.VarChar(64)
  ip                    String?  @db.VarChar(64)
  occurredAt            DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  program               WelfareCardProgram @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([programId, occurredAt], map: "welfare_card_program_history_program_time_idx")
  @@map("welfare_card_program_history")
}

model WelfareCardBatchHistory {
