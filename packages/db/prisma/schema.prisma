generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum SupplierStatus {
  DRAFT
  PENDING_REVIEW
  CORRECTION_REQUIRED
  ACTIVE
  SUSPENDED
  EXITING
  EXITED
}

enum ApprovalType {
  SUPPLIER_ONBOARDING
  FUNCTIONAL_ACCOUNT_CHANGE
  SENSITIVE_EXPORT
  SUPPLIER_SENSITIVE_CHANGE
}

enum ApprovalObjectType {
  SUPPLIER
  FUNCTIONAL_ACCOUNT
  EXPORT_JOB
}

enum ApprovalApplicantType {
  COMPANY_USER
  SUPPLIER_USER
}

enum ApprovalTaskStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAccountTypeCode {
  COMPANY_SUPPLIER_OPS
  COMPANY_SUPER_ADMIN
  COMPANY_AUDIT
  SUPPLIER_ACCOUNT_ADMIN
}

enum SupplierStatusEvent {
  REGISTER
  SUBMIT
  REQUEST_CORRECTION
  RESUBMIT
  APPROVE
  SUSPEND
  START_EXIT
  COMPLETE_EXIT
}

model Company {
  id                 String        @id @default(uuid()) @db.Char(36)
  legalName          String        @unique @map("legal_name") @db.VarChar(128)
  platformName       String        @unique @map("platform_name") @db.VarChar(64)
  wechatPayConfigRef String        @map("wechat_pay_config_ref") @db.VarChar(255)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  suppliers          Supplier[]

  @@map("company")
}

model Supplier {
  id                      String                  @id @default(uuid()) @db.Char(36)
  companyId               String                  @map("company_id") @db.Char(36)
  legalName               String                  @map("legal_name") @db.VarChar(128)
  creditCode              String                  @unique @map("credit_code") @db.Char(18)
  status                  SupplierStatus          @default(DRAFT)
  pickupAddress           String?                 @map("pickup_address") @db.VarChar(500)
  pickupLat               Decimal?                @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng               Decimal?                @map("pickup_lng") @db.Decimal(10, 7)
  settlementAccountMasked String?                 @map("settlement_account_masked") @db.VarChar(128)
  qualificationSnapshot   Json                    @map("qualification_snapshot")
  version                 Int                     @default(0)
  submittedAt             DateTime?               @map("submitted_at") @db.DateTime(3)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory           SupplierStatusHistory[]

  @@index([companyId, status], map: "supplier_company_id_status_idx")
  @@map("supplier")
}

model ApprovalTask {
  id                      String                  @id @default(uuid()) @db.Char(36)
  approvalType            ApprovalType            @map("approval_type")
  objectType              ApprovalObjectType      @map("object_type")
  objectId                String                  @map("object_id") @db.Char(36)
  applicantType           ApprovalApplicantType   @map("applicant_type")
  applicantId             String                  @map("applicant_id") @db.Char(36)
  status                  ApprovalTaskStatus      @default(PENDING)
  assignedAccountTypeCode ApprovalAccountTypeCode @map("assigned_account_type_code")
  reviewedBy              String?                 @map("reviewed_by") @db.Char(36)
  reviewOpinion           String?                 @map("review_opinion") @db.VarChar(1000)
  version                 Int                     @default(0)
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([objectType, objectId, status], map: "approval_task_object_status_idx")
  @@index([assignedAccountTypeCode, status], map: "approval_task_assignee_status_idx")
  @@map("approval_task")
}

model SupplierStatusHistory {
  id              String              @id @default(uuid()) @db.Char(36)
  supplierId      String              @map("supplier_id") @db.Char(36)
  fromStatus      SupplierStatus?     @map("from_status")
  toStatus        SupplierStatus      @map("to_status")
  event           SupplierStatusEvent
  actorIdentityId String?             @map("actor_identity_id") @db.Char(36)
  version         Int
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.DateTime(3)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, version], map: "supplier_status_history_supplier_version_key")
  @@index([supplierId, occurredAt], map: "supplier_status_history_supplier_time_idx")
  @@map("supplier_status_history")
}

model SupplierOnboardingCommand {
  id               String   @id @default(uuid()) @db.Char(36)
  scope            String   @db.VarChar(128)
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  requestHash      String   @map("request_hash") @db.Char(64)
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, idempotencyKey], map: "supplier_onboarding_command_scope_key")
  @@map("supplier_onboarding_command")
}
